generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/nightfall_last_survivors/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  email          String?        @unique
  passwordHash   String
  isAdmin        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  saves          PlayerSave[]
  ownedServers   Server[]       @relation("ServerOwner")
  memberships    ServerMember[]
  allowedIn      ServerFriend[] @relation("FriendUser")
}

model PlayerSave {
  id             String   @id @default(cuid())
  // Slot formats:
  //   "default"                          — legacy guest default (pre-multiplayer)
  //   "user_<userId>_server_<serverId>"  — signed-in user on a specific server
  //   "guest_<guestId>_server_<serverId>" — guest on a specific server
  slot           String   @unique @default("default")
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Scope the save to a specific server so characters aren't shared across lobbies.
  serverId       String?
  health         Int      @default(100)
  level          Int      @default(1)
  xp             Int      @default(0)
  posX           Float    @default(0)
  posY           Float    @default(2)
  posZ           Float    @default(0)
  timeOfDay      Float    @default(0.25)
  equippedItem   String?
  inventoryJson  String   @default("[]")
  structuresJson String   @default("[]")
  deaths         Int      @default(0)
  zombiesKilled  Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([serverId])
}

// --- Multiplayer servers / lobbies ---
model Server {
  id             String         @id @default(cuid())
  // slotNumber 1..50 for the public slots; null for private servers.
  slotNumber     Int?           @unique
  name           String
  // public: everyone can join. private: only owner + ServerFriend entries can join.
  isPrivate      Boolean        @default(false)
  maxPlayers     Int            @default(100)
  // Owner: exactly one of ownerId (logged-in user) OR ownerGuestId (guest) is set.
  ownerId        String?
  owner          User?          @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerGuestId   String?
  ownerGuestName String?
  createdAt      DateTime       @default(now())
  members        ServerMember[]
  friends        ServerFriend[]

  @@index([isPrivate])
  @@index([ownerId])
  @@index([ownerGuestId])
}

model ServerMember {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // Exactly one of userId or guestId is set. Keep userId nullable so guests can
  // still occupy a slot without a real account.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  guestName String?
  // Always set. Format: "u:<userId>" or "g:<guestId>" — used for uniqueness.
  memberKey String
  lastSeen  DateTime @default(now())
  posX      Float    @default(0)
  posY      Float    @default(2)
  posZ      Float    @default(0)
  yaw       Float    @default(0)

  @@unique([serverId, memberKey])
  @@index([serverId, lastSeen])
  @@index([userId])
}

model ServerFriend {
  id        String  @id @default(cuid())
  serverId  String
  server    Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // Exactly one of userId or guestId is set.
  userId    String?
  user      User?   @relation("FriendUser", fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  guestName String?
  // "u:<userId>" or "g:<guestId>" — used for uniqueness.
  friendKey String

  @@unique([serverId, friendKey])
  @@index([userId])
  @@index([guestId])
}
